{
  "name": "@amplop/shared",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./abi": {
      "types": "./dist/generated/amplop.d.ts",
      "default": "./dist/generated/amplop.js"
    },
    "./abi/json": "./abi/AmplopEnvelopes.json",
    "./enums": {
      "types": "./dist/enums.d.ts",
      "default": "./dist/enums.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    },
    "./money": {
      "types": "./dist/money.d.ts",
      "default": "./dist/money.js"
    },
    "./names": {
      "types": "./dist/names.d.ts",
      "default": "./dist/names.js"
    },
    "./dates": {
      "types": "./dist/dates.d.ts",
      "default": "./dist/dates.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    },
    "./schedule": {
      "types": "./dist/schedule.d.ts",
      "default": "./dist/schedule.js"
    },
    "./indexer": {
      "types": "./dist/indexer/queries.d.ts",
      "default": "./dist/indexer/queries.js"
    }
  },
  "scripts": {
    "generate": "cd ../../contracts && forge build && cd ../packages/shared && wagmi generate && node scripts/write-abi-json.mjs && prettier --write src/generated abi",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@wagmi/cli": "2.10.0"
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
