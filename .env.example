# Every environment name from specs/01-conventions.md section 7, with fake values.
# Copy to apps/web/.env.local. Never commit a real value.

# server: runtime role
DATABASE_URL=postgres://amplop_app:amplop_app@127.0.0.1:5432/amplop
# CI only: migration role
DATABASE_MIGRATION_URL=postgres://amplop_migrator:amplop_migrator@127.0.0.1:5432/amplop
# server: two providers (PRD 17)
MONAD_RPC_URL=http://127.0.0.1:8545
MONAD_RPC_URL_FALLBACK=http://127.0.0.1:8545
# browser: read and send for user transactions
NEXT_PUBLIC_MONAD_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_MONAD_RPC_URL_FALLBACK=http://127.0.0.1:8545
# browser: 10143 (31337 in tests)
NEXT_PUBLIC_CHAIN_ID=31337
# browser and server
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_AUSD_ADDRESS=0x0000000000000000000000000000000000000000
# browser: prefix for "View transaction proof" links
NEXT_PUBLIC_EXPLORER_TX_URL=http://127.0.0.1:8545/tx/
# browser: Envio GraphQL
NEXT_PUBLIC_INDEXER_URL=http://127.0.0.1:8080/v1/graphql
# browser: shows demo controls only; the server and contract still decide
NEXT_PUBLIC_DEMO_MODE=true
# server: true only on the demo deployment
DEMO_MODE=true
# server
SETTLEMENT_ADDRESS=0x0000000000000000000000000000000000000000
# server: never NEXT_PUBLIC_; three different wallets by submission
TREASURY_PRIVATE_KEY=0x1111111111111111111111111111111111111111111111111111111111111111
CARD_SERVICE_PRIVATE_KEY=0x1111111111111111111111111111111111111111111111111111111111111111
FEE_SPONSOR_PRIVATE_KEY=0x1111111111111111111111111111111111111111111111111111111111111111
# server
MIDTRANS_SERVER_KEY=SB-Mid-server-REPLACE_ME
MIDTRANS_IS_PRODUCTION=false
# server: shown on screen as "sample rate"
SAMPLE_RATE_IDR_PER_USD=16500
SAMPLE_RATE_USD_PER_EUR=1.1511
# server
CRON_SECRET=fake-cron-secret-0000000000000000000000
# server, optional: fee-sponsor cap and treasury alerts; payload {text}
ALERT_WEBHOOK_URL=
# server, optional: testnet AUSD faucet with requestFunds(address); unset means refill by hand
AUSD_FAUCET_ADDRESS=
# server: hosts accepted in the signed message's Site line and in Origin
SITE_HOSTS=localhost:3000
# browser: must equal the server values
NEXT_PUBLIC_SAMPLE_RATE_IDR_PER_USD=16500
NEXT_PUBLIC_SAMPLE_RATE_USD_PER_EUR=1.1511
# browser: links on the landing page and docs; a link whose value is unset is hidden
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DOCS_URL=
NEXT_PUBLIC_REPO_URL=
NEXT_PUBLIC_DEMO_VIDEO_URL=
# server, tests only: accepted only for localhost, 127.0.0.1 or *.midtrans.com
MIDTRANS_API_BASE_URL=http://127.0.0.1:4010
# deploy machine only: never in Vercel (spec 04)
AUSD_ADDRESS=0x0000000000000000000000000000000000000000
TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
CARD_SERVICE_ADDRESS=0x0000000000000000000000000000000000000000
DEPLOYER_ACCOUNT=amplop-deployer
SETTLEMENT_PRIVATE_KEY=0x1111111111111111111111111111111111111111111111111111111111111111
OLD_CONTRACT_ADDRESS=
