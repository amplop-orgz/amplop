# S02-10: secrets, then lint-staged, then types for staged TypeScript workspaces.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is not installed. Install it: brew install gitleaks (or see https://github.com/gitleaks/gitleaks#installing)" >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml
npx lint-staged
staged=$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' '*.mts')
for ws in packages/shared apps/web apps/docs indexer; do
  if echo "$staged" | grep -q "^$ws/" && [ -f "$ws/tsconfig.json" ]; then
    (cd "$ws" && npx tsc -b --noEmit) || exit 1
  fi
done
